// Rust/Wasm backend-local source fold: deterministic, not cryptographic.
// Invalid state/octets return -1; no signed overflow or implementation-defined
// modulo; Hash trait for arbitrary values requires canonical encoding.
define module hash as
  pub fnc initial_state(): int { return 17; }
  pub fnc step_byte(int s, int octet): int {
    if s < 0 || s >= 1000000007; do return -1; fi
    if octet < 0 || octet > 255; do return -1; fi
    let int next = s * 31 + octet;
    while next >= 1000000007 {
      next = next - 1000000007;
    }
    return next;
  }
  pub fnc two_bytes(int first, int second): int {
    let int seed = step_byte(initial_state(), first);
    if seed < 0; do return -1; fi
    return step_byte(seed, second);
  }
  pub fnc from_bool(bool value): int {
    if value; do return step_byte(initial_state(), 1); fi
    return step_byte(initial_state(), 0);
  }
end
