// ---------------------------------------------------------------- channels
// Channel (72 bytes): 0 capacity (-1 unbounded), 8 count, 16 head, 24 tail,
// 32 closed, 40/48 queue of pending `nb readch` futures.
// 56 unique pipeline producer actor, 64 unique pipeline consumer actor.
// These two additional words prevent silent duplicate DATA attachments.

// Only the internal unbounded constructor may use capacity -1. Other
// negative values are invalid; never silently turn them into unbounded queues.
fnc __chan_new(int cap): int {
  if cap < -1 then
    __panic(14);
  fi
  val c = __alloc(72);
  __store(c, 0, cap);
  return c;
}

// Public bounded admission must reject -1 as well: it is the separate
// private unbounded sentinel, not a valid bounded capacity.
fnc __chan_new_bounded(int cap): int {
  if cap < 0 then
    __panic(14);
  fi
  return __chan_new(cap);
}

// 1 when the value was accepted, 0 when a bounded channel is full.
fnc __chan_offer(int c, int v): int {
  if __load(c, 32) != 0 then
    __panic(8);
  fi
  if __load(c, 40) != 0 then
    __fut_done(__q_pop(c + 40), __some(v));
    return 1;
  fi
  val cap = __load(c, 0);
  if cap >= 0 then
    if __load(c, 8) >= cap then
      return 0;
    fi
  fi
  __q_push(c + 16, v);
  __store(c, 8, __load(c, 8) + 1);
  __set_rt(4, 1);
  return 1;
}

suspends fnc __chan_send(int c, int v): void {
  // Recheck on EVERY retry. A caller may have suspended on backpressure
  // while a different task atomically admitted the channel to a graph.
  loop do
    if __load(c, 56) != 0 then __panic(10); fi
    if __load(c, 64) != 0 then __panic(10); fi
    if __chan_offer(c, v) != 0 then return; fi
    __suspend();
  done
}

// Compiler-runtime-only DATA producer path; never exposed to guest source.
// Validate the owning actor, not merely the channel pointer.
suspends fnc __chan_send_pipe(int actor, int c, int v): void {
  loop do
    if __load(c, 56) != actor then __panic(10); fi
    if __load(actor, 8) != c then __panic(10); fi
    if __load(actor, 24) != 1 then __panic(10); fi
    if __chan_offer(c, v) != 0 then return; fi
    __suspend();
  done
}

fnc __chan_take(int c): int {
  __store(c, 8, __load(c, 8) - 1);
  __set_rt(4, 1);
  return __q_pop(c + 16);
}

suspends fnc __chan_recv(int c): int {
  loop do
    // A blocked public reader must not consume DATA after pipeline
    // admission merely because it started before the ownership change.
    if __load(c, 56) != 0 then __panic(10); fi
    if __load(c, 64) != 0 then __panic(10); fi
    if __load(c, 8) > 0 then
      return __chan_take(c);
    fi
    if __load(c, 32) != 0 then
      __panic(9);
    fi
    // A capacity-zero channel cannot buffer. A polling reader never
    // advertises a rendezvous partner to __chan_offer, so both tasks would
    // suspend forever. Register exactly one pending read, then await its
    // completion. A close resolves that future as None.
    if __load(c, 0) == 0 then
      val pending = __chan_nb(c);
      val ready = await __await(pending);
      // A DATA graph must never turn an old suspended public read into a
      // backdoor after claiming this channel.
      if __load(c, 56) != 0 then __panic(10); fi
      if __load(c, 64) != 0 then __panic(10); fi
      if ready == 0 then __panic(9); fi
      return __load(ready, 0);
    fi
    __suspend();
  done
}

// Public Channel<T> iterator read. A caller may have suspended before
// the channel's owner changed; recheck BOTH DATA ports on every retry.
// Only internal actor/bridge code may use __chan_recv_opt below.
suspends fnc __chan_recv_user_opt(int c): int {
  loop do
    if __load(c, 56) != 0 then __panic(10); fi
    if __load(c, 64) != 0 then __panic(10); fi
    if __load(c, 8) > 0 then
      return __some(__chan_take(c));
    fi
    if __load(c, 32) != 0 then
      return 0;
    fi
    // for-await readers on rendezvous channels also need to register,
    // rather than spin without a partner for a suspended producer.
    if __load(c, 0) == 0 then
      val pending = __chan_nb(c);
      val ready = await __await(pending);
      if __load(c, 56) != 0 then __panic(10); fi
      if __load(c, 64) != 0 then __panic(10); fi
      return ready;
    fi
    __suspend();
  done
}

// Some(item), or None once the channel is closed and drained.
suspends fnc __chan_recv_opt(int c): int {
  loop do
    if __load(c, 8) > 0 then
      return __some(__chan_take(c));
    fi
    if __load(c, 32) != 0 then
      return 0;
    fi
    __suspend();
  done
}

fnc __chan_try(int c): int {
  if __load(c, 56) != 0 then __panic(10); fi
  if __load(c, 64) != 0 then __panic(10); fi
  if __load(c, 8) > 0 then
    return __some(__chan_take(c));
  fi
  return 0;
}

fnc __chan_nb(int c): int {
  if __load(c, 56) != 0 then __panic(10); fi
  if __load(c, 64) != 0 then __panic(10); fi
  val f = __fut_new();
  if __load(c, 8) > 0 then
    __fut_done(f, __some(__chan_take(c)));
    return f;
  fi
  if __load(c, 32) != 0 then
    __fut_done(f, 0);
    return f;
  fi
  __q_push(c + 40, f);
  return f;
}

// Internal EOF propagation is allowed for the current graph owner only.
fnc __chan_close_internal(int c): void {
  if __load(c, 32) != 0 then
    return;
  fi
  __store(c, 32, 1);
  while __load(c, 40) != 0 do
    __fut_done(__q_pop(c + 40), 0);
  done
  __set_rt(4, 1);
}

fnc __chan_close(int c): void {
  if __load(c, 56) != 0 then __panic(10); fi
  if __load(c, 64) != 0 then __panic(10); fi
  __chan_close_internal(c);
}