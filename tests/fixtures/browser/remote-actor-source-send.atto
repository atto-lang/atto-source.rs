// Source-level browser actor-to-actor send acceptance.
// This guest is booted with slot 1 bound to a supervisor route targeting
// a separately compiled Counter actor in another tenant worker.
define actor Counter as
    let int total = 0;
    receive(ActorMail<int> mail): void {
        self.total = self.total + mail.value;
        stdio.println(self.total);
        return;
    }
end

define actor Sender as
    receive(ActorMail<int> mail): void {
        val remote = remote_actor(Counter, 1);
        remote.send(mail.value);
        return;
    }
end

pub fnc main(): int {
    val sender = spawn Sender();
    sender.send(40);
    sender.send(2);
    return 0;
}
