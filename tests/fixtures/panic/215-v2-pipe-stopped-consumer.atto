// expect-panic: 10
// A stopped consumer cannot acquire an incoming DATA edge or spawn a bridge.
define actor Consumer receives int as
  receive(ActorMail<int> mail): void { stdio.println(mail.value); return; }
end
pub suspends fnc main(): int {
  val consumer = spawn Consumer();
  val channel = Channel<int>.bounded(1);
  consumer.stop();
  val invalid = channel pipe consumer;
  return 0;
}
