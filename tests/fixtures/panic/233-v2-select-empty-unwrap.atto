// v2 guest: a missing SelectResult is an unwrap fault, not scheduler deadlock.
// expect-panic: 13
pub suspends fnc main(): int {
  val ch = Channel<int>.bounded(1);
  val plan = SelectPlan.from_list([SelectCase.read(ch)]);
  val Option<SelectResult> missing = try select first from plan;
  return missing.unwrap().value;
}
