// v2 guest: no viable channel must fault, not park indefinitely.
// expect-panic: 9
pub suspends fnc main(): int {
  val ch = Channel<int>.bounded(1);
  ch.close();
  val plan = SelectPlan.from_list([SelectCase.read(ch)]);
  val Option<SelectResult> hit = try select first from plan;
  return 42;
}
