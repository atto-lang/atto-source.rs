// A false left operand must not suppress a checked-arithmetic RHS panic.
// expect-panic: 1
// expect-stdout: rhs
fnc crash(): bool {
  stdio.println("rhs");
  val biggest = 9223372036854775807;
  return biggest + 1 eq 0;
}

pub fnc main(): int {
  if false, crash() then
    return 7;
  fi
  return 0;
}
