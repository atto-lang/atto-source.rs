// expect-panic: 10
// A closed bounded channel cannot be attached as a DATA destination.
define actor Producer receives int emits int as
  receive(ActorMail<int> mail): void { emit(mail.value); return; }
end
pub suspends fnc main(): int {
  val producer = spawn Producer();
  val channel = Channel<int>.bounded(1);
  channel.close();
  val invalid = producer pipe channel;
  return 0;
}
