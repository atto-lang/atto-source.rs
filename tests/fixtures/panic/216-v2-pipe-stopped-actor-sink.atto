// expect-panic: 10
// A stopped actor-to-actor sink must not publish the upstream's pointer.
define actor Producer receives int emits int as
  receive(ActorMail<int> mail): void { emit(mail.value); return; }
end
define actor Consumer receives int as
  receive(ActorMail<int> mail): void { stdio.println(mail.value); return; }
end
pub suspends fnc main(): int {
  val producer = spawn Producer();
  val consumer = spawn Consumer();
  consumer.stop();
  val invalid = producer pipe consumer;
  return 0;
}
