// M8 restricted executable actor: same shape as Java M7 compiled fixture.
define actor CooperativeSum as {
    pub fnc on_message(int amount): int {
        let total: int = 0;
        let i: int = 0;
        while (i < amount) {
            total = total + i;
            i = i + 1;
            rt cooperate;
        }
        return total;
    }
}
