// v2 guest: a closed channel with buffered DATA remains readable before EOF.
// expect-exit: 42
// expect-stdout: 0\n
pub suspends fnc main(): int {
  val buffered = Channel<int>.bounded(1);
  val idle = Channel<int>.bounded(1);
  writech buffered, 42;
  buffered.close();
  val SelectPlan plan = SelectPlan.from_list([
    SelectCase.read(buffered), SelectCase.read(idle)
  ]);
  val Option<SelectResult> hit = try select first from plan;
  stdio.println(hit.unwrap().index);
  return hit.unwrap().value;
}
