// atto-ownership: borrow-default-v1
// expect-exit: 42
// java: rejects
define class Counter as pub mut int value = 40; end
fnc read(Counter p): int { return p.value; }
fnc update(mut Counter p): void { p.value = 42; }
pub fnc main(): int {
  let counter = new Counter();
  val observed = read(counter);
  update(mut counter);
  return read(borrow! counter);
}
