// v2 guest: a suspended blocking select captures the original case generation.
// expect-exit: 42
// The paused worker must still read the original channel after put/remove;
// polling a mutated live plan would deadlock (guest panic 6).
pub suspends fnc main(): int {
  val original = Channel<int>.bounded(1);
  val replacement = Channel<int>.bounded(1);
  val DynamicSelectPlan<int> plan = DynamicSelectPlan<int>.from_list([
    SelectCase.read(original)
  ]);
  val worker = task {
    val SelectResult chosen = select first from plan;
    return chosen.value;
  };
  // Force the guest scheduler to run the worker into its pending select
  // before mutating the plan's live descriptor table.
  val tick = task { return 0; };
  await tick;
  val bool removed = plan.remove(0);
  plan.put(0, SelectCase.read(replacement));
  writech original, 42;
  return await worker;
}
