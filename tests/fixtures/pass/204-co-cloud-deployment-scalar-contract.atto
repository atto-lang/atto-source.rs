// expect-exit: 42
// Integration snapshot: atto-co/atto-cloud-control-plane.rs/contracts/v1/deployment_intent.atto (1ec4bbee024242a244f30d0d1b3bb677a6442a12)
// Proposed Atto Cloud deployment-intent v1 numeric admission projection.
// JSON Schema is normative; these pure functions do NOT authenticate tenant.
pub fnc valid_v1_version(int version): bool {
    return version == 1;
}

pub fnc valid_v1_memory_bytes(int memory_bytes): bool {
    return And(memory_bytes >= 1048576, memory_bytes <= 1099511627776);
}

pub fnc valid_v1_cpu_millis(int cpu_millis): bool {
    return And(cpu_millis >= 1, cpu_millis <= 60000);
}


pub fnc main(): int {
  if valid_v1_version(1),
      !valid_v1_version(2),
      valid_v1_memory_bytes(1048576),
      valid_v1_memory_bytes(1099511627776),
      !valid_v1_memory_bytes(1048575),
      !valid_v1_memory_bytes(1099511627777),
      valid_v1_cpu_millis(1),
      valid_v1_cpu_millis(60000),
      !valid_v1_cpu_millis(0),
      !valid_v1_cpu_millis(60001) then
    return 42;
  fi
  return 0;
}
