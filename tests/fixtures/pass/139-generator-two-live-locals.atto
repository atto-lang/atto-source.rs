// expect-exit: 10
// java: llvm-design
// Both counter and running sum survive every suspension.
fnc *gen running_totals(int limit): Generator<int> {
  let count = 0;
  let total = 0;
  while count < limit do
    count += 1;
    total += count;
    yield total;
  done
}
pub fnc main(): int {
  let sum = 0;
  for value in running_totals(3) do
    sum += value;
  done
  return sum; // 1 + 3 + 6 = 10
}
