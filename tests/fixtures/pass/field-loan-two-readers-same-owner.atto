// expect-exit: 42
// expect-stdout: Alice
// expect-stdout: 30
// java: rejects
define class Person as
  pub let string name = "Alice";
  pub let int age = 30;
end
pub fnc main(): int {
  let person = new Person();
  block {
    val name_view = borrow! person.name;
    val age_view = borrow! person.age;
    stdio.println(name_view);
    stdio.println(age_view);
  }
  person.age = 42;
  return person.age;
}
