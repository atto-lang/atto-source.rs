// expect-exit: 1
// java: target-only
define class Particle as
    mut int n = 0;
    constructor(int v) { self.n = v; }
    pub value(): int { return self.n; }
end
pub fnc main(): int { let total=0; for (Particle p : [new Particle(1), new Particle(2)]) { if p.value() eq 2 { break; } total=total+p.value(); } return total; }
