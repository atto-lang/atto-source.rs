// expect-exit: 15
define struct Particle {
    x: int;
    y: int;
    velocity: int;
}

type Base = <T=Particle, size=5, layout=soa>;

fnc main() -> int {
    let particles: Array<infer X from Base> = [
        make {x:10, y:20, velocity:1},
        make {velocity:2, x:30, y:40}
    ] with {size=infer};
    particles[0].x += 5;
    return particles.columns.x[0];
}
