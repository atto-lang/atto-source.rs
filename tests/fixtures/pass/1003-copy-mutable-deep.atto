// java: rejects
define class Scores as pub let int n = 20; end
define class Person as pub let mut Scores scores = new Scores(); pub let int age = 1; end
pub fnc main(): int { let mut Person a = new Person(); a.scores.n = 10; let mut Person b = copy! a; let mut Person c = copy!! b; c.scores.n = 22; return a.scores.n + b.scores.n + c.scores.n; }
