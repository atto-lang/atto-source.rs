// expect-exit: 42
// expect-stdout: 42
// java: rejects
// A temporary shared-handle duplication does not consume the source shared owner.
define class Parcel as
  pub let int value = 42;
end
pub fnc main(): int {
  val owned = new Parcel();
  val outer = share! owned;
  block {
    val inner = share! outer;
    stdio.println(inner.value);
  }
  return outer.value;
}
