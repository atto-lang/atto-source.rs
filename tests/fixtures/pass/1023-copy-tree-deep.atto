// expect-exit: 42
// java: rejects
define class Scores as pub let int n = 20; end
define class Profile as pub let mut Scores scores = new Scores(); end
define class Person as pub let mut Profile profile = new Profile(); pub let int age = 1; end
pub fnc main(): int { let mut Person a = new Person(); a.profile.scores.n = 10; let mut Person b = copy! a; let mut Person c = copy!! b; c.profile.scores.n = 22; return a.profile.scores.n+b.profile.scores.n+c.profile.scores.n; }
