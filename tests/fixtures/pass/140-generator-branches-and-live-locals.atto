// expect-exit: 16
// java: llvm-design
fnc *gen branch_totals(int limit): Generator<int> {
  let i = 0;
  let accumulated = 0;
  while i < limit do
    i += 1;
    if i < 3 then
      accumulated += i;
    else
      accumulated += 2;
    fi
    yield accumulated;
  done
}
pub fnc main(): int {
  let sum = 0;
  for n in branch_totals(4) do sum += n; done
  return sum; // 1 + 3 + 5 + 7 = 16
}
