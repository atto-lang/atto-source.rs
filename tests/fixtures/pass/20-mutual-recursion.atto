// functions may be called before their declaration
// expect-exit: 1
pub fnc main(): int {
  if is_even(10), is_odd(7) then
    return 1;
  fi
  return 0;
}

fnc is_even(int n): bool {
  if n eq 0 then
    return true;
  fi
  return is_odd(n - 1);
}

fnc is_odd(int n): bool {
  if n eq 0 then
    return false;
  fi
  return is_even(n - 1);
}
