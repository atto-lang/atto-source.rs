// expect-exit: 42
// expect-stdout: 42
// Playground showcase: structured task result and detached side effect.
suspends fnc twice(int n): int {
  val future: Future<int> = task {
    return n * 2;
  };
  return await future;
}

pub suspends fnc main(): int {
  val result = await twice(21);
  // A finishing tail task may append a child before scheduler unlink.
  // That child must survive even though its parent's stack is recycled.
  val nested: Future<Future<int>> = task {
    val child: Future<int> = task {
      return 7;
    };
    return child;
  };
  val child = await nested;
  val value = await child;
  if value != 7 then return 1; fi
  if (await child) != 7 then return 2; fi
  do task {
    stdio.println(result);
  };
  return result;
}
