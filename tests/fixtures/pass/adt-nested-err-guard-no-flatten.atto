// expect-exit: 42
// Some(Err) stays Some; the nested Err guard checks the contained string.
fnc nested(): Option<Result<int,string>> { return Some(Err("failed")); }
fnc failure(Result<int,string> candidate): bool {
  match candidate over
    on Ok(n) -> { return false; }
    on Err(message) when message == "failed" -> { return true; }
    on Err(message) -> { return false; }
  end
}
pub fnc main(): int {
  match nested() over
    on Some(inner) when failure(inner) -> { return 42; }
    on Some(inner) -> { return 1; }
    on None -> { return 0; }
  end
}
