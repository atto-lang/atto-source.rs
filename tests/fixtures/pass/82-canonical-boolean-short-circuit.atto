// RHS is evaluated for ^^ and named Boolean functions, not for skipped &&/||.
// expect-exit: 42
// expect-stdout: 1
// expect-stdout: 3
// expect-stdout: 5
// expect-stdout: 6
// expect-stdout: 7
// expect-stdout: 8
// expect-stdout: 9
// expect-stdout: 10
// expect-stdout: 11
// expect-stdout: 12
// java: llvm-design
fnc mark(bool v, int n): bool {
  stdio.println(n);
  return v;
}
pub fnc main(): int {
  let hits = 0;
  if mark(false, 1) && mark(true, 2) then
    return -1;
  fi
  if mark(true, 3) || mark(false, 4) then
    hits = hits + 1;
  fi
  if mark(false, 5) || mark(true, 6) then
    hits = hits + 1;
  fi
  if mark(true, 7) && mark(true, 8) then
    hits = hits + 1;
  fi
  if mark(false, 9) ^^ mark(true, 10) then
    hits = hits + 1;
  fi
  if And(mark(false, 11), mark(true, 12)) then
    return -2;
  fi
  return hits eq 4 ? 42 : 0;
}
