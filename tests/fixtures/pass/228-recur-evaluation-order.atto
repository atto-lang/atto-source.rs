// expect-exit: 72
// expect-stdout: 7
// expect-stdout: 2
// java: target-only
fnc observe(int n): int { stdio.println(n); return n; }
pub fnc main(): int {
  return loop (val a: int = 2, val b: int = 7, val n: int = 0) {
    if n eq 1 { break a * 10 + b; }
    recur(observe(b), observe(a), n + 1);
  };
}
