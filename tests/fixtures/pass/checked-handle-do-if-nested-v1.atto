// expect-exit: 42
// expect-stdout: 84
// java: rejects
define class Parcel as
  pub let int value = 42;
end
fnc inspect_readonly(borrow! Parcel item): int { return item.value; }
pub fnc main(): int {
  val original = new Parcel();
  val handle = ref! original;
  block {
    val view = deref! handle;
    do if true then
      do if false then
        stdio.println(0);
      else
        stdio.println(inspect_readonly(view) + view.value);
      fi
    else
      stdio.println(0);
    fi
  }
  val restored = unref! handle;
  return restored.value;
}
