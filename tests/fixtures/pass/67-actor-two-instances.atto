// Two actors of one type have independent state (separate instances).
// Different actors run concurrently, so their lines may interleave in any order.
// stdout-order: unordered
// expect-exit: 0
// expect-stdout: 1
// expect-stdout: 2
define actor A as
    state { let int base = 0; }
    receive(ActorMail<int> mail): void {
        self.handle_state(critical-write |s| -> {
            self.base = self.base + mail.value;
            stdio.println(self.base);
        });
        return;
    }
end

pub fnc main(): int {
    val x = spawn A();
    val y = spawn A();
    x.send(1);
    y.send(2);
    return 0;
}
