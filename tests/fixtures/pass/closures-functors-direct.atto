// expect-exit: 84
// A bounded direct closure capture and a normal class functor run in one guest.
fnc multiply(int factor): int {
  val captured_factor = factor;
  val triple = |value| : int -> value * captured_factor;
  return triple(14);
}

define class AddOffset as
  int offset: 0;

  constructor(int offset) {
    self.offset = offset;
  }

  pub call(int value): int {
    return value + self.offset;
  }
end

pub fnc main(): int {
  val plus_seven = new AddOffset(7);
  return multiply(3) + plus_seven.call(35);
}
