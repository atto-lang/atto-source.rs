// expect-exit: 41
// Non-taken throw is not a failure, and normal values stay Some.
fnc maybe_fail(bool should_fail): int {
  if should_fail then
    throw Error("unreached");
  fi
  return 41;
}
pub fnc main(): int {
  match trap maybe_fail(false) over
    on Some(value) -> { return value; }
    on None -> { return 0; }
  end
}
