// expect-exit: 42
// The checked read-payload profile is two immutable tagged ADTs:
// Result<Option<int>,IoError> is NOT an int with EOF=0.
pub fnc main(): int {
  val outcome: Result<Option<int>,IoError> = Ok(Some(41));
  match outcome over
    on Ok(item) -> {
      match item over
        on Some(value) -> { return value + 1; }
        on None -> { return 0; }
      end
    }
    on Err(error) -> { return -1; }
  end
}
