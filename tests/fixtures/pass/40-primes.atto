// count primes below 100 with subtraction-based divisibility
// expect-exit: 25
fnc is_prime(int n): bool {
  if n < 2 then
    return false;
  fi
  for (let d = 2; d * d <= n; d++) do
    let t = n;
    while t >= d do
      t = t - d;
    done
    if t eq 0 then
      return false;
    fi
  done
  return true;
}

pub fnc main(): int {
  let count = 0;
  for (let n = 0; n < 100; n++) do
    if is_prime(n) then
      count = count + 1;
    fi
  done
  return count;
}
