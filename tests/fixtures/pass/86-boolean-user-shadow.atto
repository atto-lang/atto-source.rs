// User-defined callable shadowing the intrinsic preserves eager calls.
// expect-exit: 42
// expect-stdout: called-left
// expect-stdout: called-right
// expect-stdout: shadow
fnc mark(bool v, string message): bool {
  stdio.println(message);
  return v;
}
fnc And(bool left, bool right): bool {
  stdio.println("shadow");
  return right;
}
pub fnc main(): int {
  if And(mark(false, "called-left"), mark(true, "called-right")) then
    return 42;
  fi
  return 0;
}
