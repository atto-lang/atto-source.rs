// atto-ownership: borrow-default-v1
// expect-exit: 42
define class Left as
    pub let int padding = 99;
    pub let int value = 6;
end
define class Right as
    pub let int value = 48;
    pub let int padding = 88;
end
fnc difference(Left a, Right b): int { return b.value - a.value; }
pub fnc main(): int {
    let left = new Left();
    let right = new Right();
    return difference(left, borrow! right);
}
