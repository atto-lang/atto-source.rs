// Browser-v2 LEGACY actor-only guest; NOT the declared emits/PipeHandle contract.
// expect-exit: 42
// expect-stdout: 42
define actor Producer as
  receive(ActorMail<int> mail): void {
    emit(mail.value + 2);
    return;
  }
end
define actor Consumer as
  receive(ActorMail<int> mail): void {
    stdio.println(mail.value);
    return;
  }
end
pub suspends fnc main(): int {
  val producer = spawn Producer();
  val consumer = spawn Consumer();
  val link = producer pipe consumer;
  producer.send(40);
  return 42;
}
