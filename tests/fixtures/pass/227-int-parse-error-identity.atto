// expect-exit: 42
fnc read_id(string text): Result<int,Error> {
  val result: Result<int,Error> = int.parse(text);
  return result;
}
pub fnc main(): int {
  match read_id("abc") over
    on Ok(_) -> { return 0; }
    on Err(e) -> {
      if e.message eq "invalid integer" then return 42;
      else return 0;
      fi
    }
  end
}
