// expect-exit: 42
// expect-stdout: bad
// Str payload used by the guard must be initialized before comparison.
fnc result(): Result<int,string> { return Err("bad"); }
pub fnc main(): int {
  match result() over
    on Err(message) when message == "bad" -> {
      stdio.println(message);
      return 42;
    }
    on Err(message) -> { return 1; }
    on Ok(n) -> { return n; }
  end
}
