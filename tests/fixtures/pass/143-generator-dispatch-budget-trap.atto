// expect-panic: 5
// java: llvm-design
// This generator intentionally never yields or finishes; next() must be
// stopped by a bounded dispatch budget rather than hanging a tenant.
fnc *gen stuck(): Generator<int> {
  let count = 0;
  while true do
    count += 1;
  done
}
pub fnc main(): int {
  for value in stuck() do return value; done
  return 0;
}
