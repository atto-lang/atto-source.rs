// expect-exit: 7
// expect-stdout: negative identifier
// A returned Err is passed as typed DATA, never automatically thrown/trapped.
fnc checked_id(int id): Result<int,string> {
  if id < 0 then return Err("negative identifier"); fi
  return Ok(id);
}
fnc identity_result(value: Result<int,string>): Result<int,string> {
  return value;
}
pub fnc main(): int {
  val Option<Result<int,string>> outer = trap (-1 |> checked_id |> identity_result);
  match outer over
    on Some(inner) -> {
      match inner over
        on Ok(value) -> { return value; }
        on Err(message) -> { stdio.println(message); return 7; }
      end
    }
    on None -> { return 99; }
  end
}
