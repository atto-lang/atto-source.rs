// Eager RHS must execute even on the final false LHS while test.
// expect-exit: 2
// expect-stdout: 7
// expect-stdout: 7
// expect-stdout: 7
// java: diverges
// Java short-circuits , and |; canonical AttoLang evaluates both operands (PR #4).
// java-stdout: 7
// java-stdout: 7
fnc tagged(bool b): bool {
  stdio.println(7);
  return b;
}

pub fnc main(): int {
  let i = 0;
  while i < 2, tagged(true) do
    i = i + 1;
  done
  return i;
}
