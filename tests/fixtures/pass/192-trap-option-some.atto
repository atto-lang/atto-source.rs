// expect-exit: 21
fnc maybe(): Option<int> { return Some(21); }
pub fnc main(): int {
  val Result<Option<int>,Error> result = trap maybe();
  match result over
    on Err(e) -> { return 0; }
    on Ok(choice) -> {
      match choice over
        on None -> { return 0; }
        on Some(n) -> { return n; }
      end
    }
  end
}
