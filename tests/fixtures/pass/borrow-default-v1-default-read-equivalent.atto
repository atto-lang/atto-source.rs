// atto-ownership: borrow-default-v1
// expect-exit: 42
// In v1 Foo in a top-level formal is equivalent to Borrow<Foo>.
define class Parcel as pub let int value = 21; end
fnc inspect(Parcel p): int { return p.value; }
pub fnc main(): int {
  let parcel = new Parcel();
  val implicit_value = inspect(parcel);
  val explicit_value = inspect(borrow! parcel);
  return implicit_value + explicit_value;
}
