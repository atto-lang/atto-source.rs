// Compile-time edge types come from emitted values, NOT the incoming mail type.
// expect-exit: 0
// expect-stdout: true
// java: llvm-design
define actor Parse as
    receive(ActorMail<int> mail): void {
        emit(mail.value > 0);
        return;
    }
end

define actor Validate as
    receive(ActorMail<bool> mail): void {
        if mail.value then
            emit(mail.value);
        fi
        return;
    }
end

define actor Sink as
    receive(ActorMail<bool> mail): void {
        stdio.println(mail.value);
        return;
    }
end

pub fnc main(): int {
    val pipeline = spawn Parse() pipe spawn Validate() | spawn Sink();
    pipeline.send(41);
    return 0;
}
