// expect-exit: 42
define class Methods as
    pub method m_colon() : int {
        return 5;
    }
    pub fnc m_colon_arrow() : int -> {
        return 5;
    }
    pub m_arrow() -> int {
        return 5;
    }
    pub m_end() -> int
        const x: int = 3;
        ^ x + 2;
    end
    pub m_delimited() -> int ::
        let int x = 3, x + 2
    end
end
pub fnc main(): int {
    val value = new Methods();
    return value.m_colon() + value.m_colon_arrow() + value.m_arrow() + value.m_end() + value.m_delimited() + 17;
}
