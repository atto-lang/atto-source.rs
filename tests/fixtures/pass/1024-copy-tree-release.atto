// expect-exit: 42
// java: rejects
define class Scores as pub let int n = 20; end
define class Profile as pub let mut Scores scores = new Scores(); end
define class Person as pub let mut Profile profile = new Profile(); pub let int age = 1; end
pub fnc main(): int { let mut Person a = new Person(); let int before = 0; block { let mut Person b = copy! a; before = b.profile.scores.n; } a.profile.scores.n = 22; return before+a.profile.scores.n; }
