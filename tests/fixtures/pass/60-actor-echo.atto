// The receive handler reads the payload and FIFO sequence from ActorMail<T>.
// expect-exit: 0
// expect-stdout: 42
// expect-stdout: 0
// expect-stdout: 1
// expect-stdout: 1
define actor Echo as
    receive(ActorMail<int> mail): void {
        stdio.println(mail.value + 2);
        stdio.println(mail.sequence);
        return;
    }
end

pub fnc main(): int {
    val e = spawn Echo();
    e.send(40);
    e.send(-1);
    return 0;
}
