// expect-exit: 43
// 'self' can be compared by identity, but is not an owned expression.
define class Marker as
    pub mut int n = 0;
    constructor(int n) { self.n = n; }
    pub equals(Marker other): bool {
        if self == other then return true; fi
        if self != other then return self.n eq other.n; fi
        return false;
    }
    pub is_self(): bool {
        return self == self;
    }
end

pub fnc main(): int {
    val a = new Marker(7);
    val b = new Marker(7);
    val c = new Marker(8);
    if a.is_self(), a eq a, a eq b, a neq c, a == a, a != b then
        return 43;
    fi
    return 0;
}
