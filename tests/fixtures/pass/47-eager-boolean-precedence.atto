// Conditional comma binds tighter than pipe; every boolean operand executes.
// expect-exit: 42
// expect-stdout: 1
// expect-stdout: 2
// expect-stdout: 3
// expect-stdout: 4
// expect-stdout: 5
// expect-stdout: 6
fnc mark(bool value, int n): bool {
  stdio.println(n);
  return value;
}

pub fnc main(): int {
  if mark(false, 1), mark(true, 2) | mark(false, 3) then
    return -1;
  fi
  if mark(true, 4) | mark(false, 5), mark(true, 6) then
    return 42;
  fi
  return 0;
}
