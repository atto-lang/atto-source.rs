// expect-exit: 0
// expect-stdout: 40
// expect-stdout: 42
define actor W as
    state { let int seen = 0; }
    bump(int v): int { return v * 2; }
    receive(ActorMail<int> mail): void {
        let int delta = self.bump(mail.value);
        self.handle_state(critical-write |s| -> {
            self.seen = self.seen + delta;
            stdio.println(self.seen);
        });
        return;
    }
end

pub fnc main(): int {
    val a = spawn W();
    a.send(20);
    a.send(1);
    return 0;
}
