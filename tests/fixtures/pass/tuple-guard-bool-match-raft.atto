// expect-exit: 42
// Real guest-Wasm execution of guarded bool return-match over two int locals.
fnc has_quorum(int voters, int acknowledgements): bool {
  return match<bool> (voters, acknowledgements) over
    on voters < 1                    -> false,
    on acknowledgements < 1          -> false,
    on acknowledgements > voters     -> false,
    on acknowledgements > voters / 2 -> true,
    default                          -> false
  end;
}

pub fnc main(): int {
  if has_quorum(0, 0) then return 1; fi
  if has_quorum(-1, 1) then return 2; fi
  if has_quorum(1, 0) then return 3; fi
  if has_quorum(4, 5) then return 4; fi
  if has_quorum(4, 2) then return 5; fi
  if has_quorum(9223372036854775807, 4611686018427387903) then return 6; fi
  if !has_quorum(1, 1) then return 7; fi
  if !has_quorum(3, 2) then return 8; fi
  if !has_quorum(4, 3) then return 9; fi
  if !has_quorum(9223372036854775807, 4611686018427387904) then return 10; fi
  return 42;
}
