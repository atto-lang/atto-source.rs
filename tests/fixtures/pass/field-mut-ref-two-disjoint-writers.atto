// expect-exit: 42
// expect-stdout: Bob
// java: rejects
define class Person as
  pub let string name = "Alice";
  pub let int age = 30;
end
pub fnc main(): int {
  let person = new Person();
  let age_ref = borrow! mut person.age;
  let name_ref = borrow! mut person.name;
  name_ref = "Bob";
  age_ref = 42;
  stdio.println(name_ref);
  return person.age;
}
