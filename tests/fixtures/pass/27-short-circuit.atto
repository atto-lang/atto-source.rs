// EAGER ',' and '|' conditions: boom() runs for both conditions.
// expect-exit: 9
// expect-stdout: boom
// expect-stdout: boom
// expect-stdout: done
// java: diverges
// Java short-circuits , and |; canonical AttoLang evaluates both operands (PR #4).
// java-stdout: done
fnc boom(): bool {
  stdio.println("boom");
  return true;
}

pub fnc main(): int {
  if false, boom() then
    return 1;
  fi
  if true | boom() then
    stdio.println("done");
    return 9;
  fi
  return 0;
}
