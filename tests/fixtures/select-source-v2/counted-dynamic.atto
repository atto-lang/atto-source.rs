suspends fnc main(): int { val Channel<int> incoming = Channel.new<int>(4); writech incoming, 3; writech incoming, 5; writech incoming, 13; writech incoming, 99; let int count = 3; val Future<Array<int>> pending = select<int>(count) over when readch incoming: int value -> { return value * 2; } end; count = 1; val Array[int] values = await pending; if values[0] == 6 && values[1] == 10 && values[2] == 26 then return readch incoming - 57; fi return 0; }
