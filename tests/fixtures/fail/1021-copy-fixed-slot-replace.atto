// expect-error: E_COPY_READONLY_SLOT
// java: rejects
define class Scores as pub let int n = 20; end
define class Person as pub val Scores scores = new Scores(); pub let int age = 1; end
pub fnc main(): int { let mut Person a = new Person(); let mut Person b = copy! a; b.scores = new Scores(); return b.scores.n; }
