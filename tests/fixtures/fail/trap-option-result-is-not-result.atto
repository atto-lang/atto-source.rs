// expect-error: E_TYPE
// java: rejects
// The Some/None boundary cannot silently disappear at a function argument.
fnc checked_id(int id): Result<int, String> {
  return Ok(id);
}
fnc consume(Result<int, String> outcome): void {
  return;
}
pub fnc main(): int {
