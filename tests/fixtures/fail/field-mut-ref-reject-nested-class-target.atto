// expect-error: E_UNSUPPORTED
// Nested object declarations themselves are not yet implemented. This test
// verifies declaration admission, NOT the projection-level borrow checker.
// java: rejects
define class Nested as
  pub let int score = 7;
end
define class Person as
  pub let Nested child;
end
pub fnc main(): int {
  let person = new Person();
  let child_ref = borrow! mut person.child;
  return 0;
}
