// expect-error: E_UNSUPPORTED
// Caller-side trap must never silently convert a panic/host fault to None.
fnc checked_id(int id): Result<int,string> {
  if id < 0 then
    return Err("negative");
  fi
  return Ok(id);
}
pub fnc main(): int {
  val Option<Result<int,string>> outcome = trap checked_id(5);
  return 0;
}
