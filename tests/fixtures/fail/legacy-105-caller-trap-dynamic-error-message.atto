// expect-error: E_UNSUPPORTED
// Legacy Option-returning trap example: now rejected without guest output.
// Dynamic string message is evaluated once and carried by the guest tag.
fnc fail(string message): int {
  throw Error(message);
}
pub fnc main(): int {
  match trap fail("ordinary") over
    on Some(value) -> { return value; }
    on None -> { return 16; }
  end
}
