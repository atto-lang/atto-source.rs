// ACTOR-BOOL-03; TARGET_REJECT=E_ACTOR_SEND_CONTRACT; NOT_EXECUTED
define actor Flag receives bool sends void as
  let bool enabled = false;
  susp receive(ActorMail<bool> mail): void {
    self.enabled = mail.value;
    stdio.println(self.enabled);
    return;
  }
end
pub susp fnc main(): int {
  val flag = spawn Flag();
  return 0;
}
