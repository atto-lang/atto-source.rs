// expect-error: E_PIPE_DIRECTION
define actor Source receives int emits int as
  receive(ActorMail<int> mail): void { emit(mail.value); return; }
end
pub suspends fnc main(): int {
  val a = spawn Source();
  val b = spawn Source();
  val c = spawn Source();
  val mixed = a pipe b rpipe c;
  return 0;
}
