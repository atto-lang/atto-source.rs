// expect-error: E_UNSUPPORTED_TYPE
// Nested storage is unavailable before ownership lowering; not lexical-loan proof.
// java: rejects
define class Child as
    pub let int value = 42;
end
define class Parcel as
    pub let Child child = new Child();
end
pub fnc main(): int {
    val parcel = new Parcel();
    val clone = copy! parcel;
    return clone.child.value;
}
