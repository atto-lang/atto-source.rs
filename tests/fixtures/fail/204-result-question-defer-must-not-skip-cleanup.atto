// expect-error: E_UNSUPPORTED
// Direct Wasm return for ? would skip registered defer/finally.
// Fail closed until early Err propagation uses the cleanup frame.
fnc failed(): Result<int,Error> { return Err(Error("boom")); }
fnc protected(): Result<int,Error> {
  defer || -> { stdio.println("cleanup"); };
  val Result<int,Error> result = trap failed();
  val int n = result?;
  return Ok(n);
}
pub fnc main(): int { return 0; }
