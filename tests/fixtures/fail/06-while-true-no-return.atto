// A literal-true while with no return still fails definite-return checking.
// The specialized caret-return exception requires a proven return in the
// body and no loop-targeting break; it must not accept this function.
// expect-error: E_RETURN
// java: rejects
fnc f(): int {
  while true do
    let int value = 3;
  done
}
pub fnc main(): int { return f(); }
