// expect-error: E_UNSUPPORTED
// Legacy Option-returning trap example: now rejected without guest output.
// Parentheses scope the entire additive expression inside the trap.
fnc fail(): int { throw Error("failure"); }
pub fnc main(): int {
  match trap (fail() + 1) over
    on Some(value) -> { return value; }
    on None -> { return 17; }
  end
}
