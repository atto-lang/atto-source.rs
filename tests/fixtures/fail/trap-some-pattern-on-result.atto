// expect-error: E_TYPE
// java: rejects
// Some and None belong to Option, not Result; no implicit match coercion.
fnc checked_id(int id): Result<int, String> {
  return Ok(id);
}
pub fnc main(): int {
  match checked_id(5) over
    on Some(value) -> { return value; }
    on None -> { return 0; }
  end
}
