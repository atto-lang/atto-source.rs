// expect-error: E_TYPE
// Legacy Option-returning trap example: now rejected without guest output.
// A successful trap evaluates the operand once, then wraps it in Some.
fnc value(): int {
  stdio.println("called");
  return 42;
}
pub fnc main(): int {
  val Option<int> answer = trap value();
  match answer over
    on Some(value) -> { return value; }
    on None -> { return 0; }
  end
}
