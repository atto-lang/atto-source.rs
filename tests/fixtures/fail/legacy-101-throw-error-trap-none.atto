// expect-error: E_UNSUPPORTED
// Legacy Option-returning trap example: now rejected without guest output.
// A guest Error thrown from a called function becomes None.
fnc fail(): int {
  throw Error("ordinary failure");
}
pub fnc main(): int {
  val Option<int> outcome = trap fail();
  match outcome over
    on Some(value) -> { return value; }
    on None -> { return 9; }
  end
}
