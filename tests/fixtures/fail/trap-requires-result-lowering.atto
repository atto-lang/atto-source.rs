// expect-error: E_UNSUPPORTED
// Result-based trap is canonical: old Option lowering must fail closed.
// No guest artifact may be emitted until Result<T, Error> and typed error joins
// preserve the original throw Error payload and identity across Wasm unwinding.

fnc checked_id(int id): Result<int, Error> {
    if id < 0 then
        return Err(Error("invalid id"));
    fi
    return Ok(id);
}

pub fnc main(): int {
    val Result<int, Error> checked = trap checked_id(5);
    return 7;
}
