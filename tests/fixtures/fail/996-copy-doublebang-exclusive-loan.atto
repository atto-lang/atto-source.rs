// expect-error: E_BORROW
// java: rejects
// An exclusive mutable loan forbids copying the owner until it has ended.
define class Parcel as
    pub let int value = 42;
end
pub fnc main(): int {
    let original = new Parcel();
    block {
        val borrowed = borrow! mut original;
        val clone = copy!! original;
        // A subsequent use is essential: without it NLL ends the unused loan.
        return clone.value + borrowed.value;
    }
}
