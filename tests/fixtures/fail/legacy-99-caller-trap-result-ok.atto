// expect-error: E_TRAP_ERROR_JOIN
// Legacy Option-returning trap example: now rejected without guest output.
// trap is caller-side; normal Ok becomes Some(Ok(...)).
fnc checked_id(int id): Result<int,string> {
  if id < 0 then return Err("id must be nonnegative"); fi
  return Ok(id);
}
pub fnc main(): int {
  val Option<Result<int,string>> value = trap checked_id(5);
  match value over
    on Some(result) -> {
      match result over
        on Ok(id) -> { return id; }
        on Err(message) -> { stdio.println(message); return 0; }
      end
    }
    on None -> { return 0; }
  end
}
