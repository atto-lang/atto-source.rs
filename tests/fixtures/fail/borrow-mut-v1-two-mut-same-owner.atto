// atto-ownership: borrow-default-v1
// expect-error: E_BORROW
// java: rejects
define class Counter as pub mut int value = 1; end
fnc conflict(mut Counter a, mut Counter b): int { return a.value + b.value; }
pub fnc main(): int {
  let counter = new Counter();
  return conflict(mut counter, borrow! mut counter);
}
