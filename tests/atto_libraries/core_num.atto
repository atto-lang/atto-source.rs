// expect-exit: 42
import module num from "core/num";
import module option from "core/option";
pub fnc main(): int {
  val int a = num.abs(0 - 5) + num.signum(0 - 9) + num.min(3, 9) + num.max(3, 9);
  val int b = (num.saturating_add(num.max_value(), 1) - num.max_value()) + num.clamp(100, 0, 10);
  val int c = option.unwrap_or(num.checked_add(num.max_value(), 1), 7) + option.unwrap_or(num.checked_sub(10, 4), 0);
  val int d = num.pow(2, 3) + (num.saturating_sub(num.min_value(), 1) - num.min_value());
  return a + b + c + d - 5;
}
