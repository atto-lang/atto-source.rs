// Standalone scalar substrate probe: real compiler execution required.
// Expected main result 42, without implicit Option/Result coercion.
fnc optional_value(bool enabled): Option<int> {
  if !enabled; do return None; fi
  return Some(40);
}
fnc checked_value(int input): Result<int, int> {
  if input < 0; do return Err(-1); fi
  return Ok(input);
}
pub fnc main(): int {
  return match optional_value(true) over
    on None -> 1,
    on Some(value) -> match checked_value(2) over
      on Err(_) -> 2,
      on Ok(extra) -> value + extra,
    end,
  end;
}
