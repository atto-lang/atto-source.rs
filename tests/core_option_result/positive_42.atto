// expect-exit: 42
// Compiler-backed scalar Option<int> / Result<int,string> smoke.
// Nested match uses the actually admitted Rust browser compiler grammar.
fnc optional_value(bool enabled): Option<int> {
  if !enabled then
    return None;
  fi
  return Some(40);
}
fnc checked_value(int input): Result<int,string> {
  if input < 0 then
    return Err("negative");
  fi
  return Ok(input);
}
pub fnc main(): int {
  match optional_value(true) over
    on Some(left) -> {
      match checked_value(2) over
        on Ok(right) -> { return left + right; }
        on Err(message) -> { return 2; }
      end
    }
    on None -> { return 1; }
  end
}
