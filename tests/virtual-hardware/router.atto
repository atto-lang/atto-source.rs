// Boolean composition uses the compiler-supported, short-circuit && / || operators.
// AttoLang IPv4 unicast forwarding decision core (NOT a packet parser).
// IPv4 addresses are unsigned 32-bit values carried in signed 64-bit int.
// This module deliberately excludes multicast and local-only destinations.

pub fnc valid_ipv4(int address): bool {
  return address >= 0 && address <= 4294967295;
}

// Do not route traffic to address ranges reserved for local delivery:
// 0/8 ("this network"), 127/8 loopback, 169.254/16 link-local,
// and 224/4+ multicast/reserved/broadcast. Connected-subnet directed
// broadcast needs external route/interface information and is not
// authenticated by this predicate.
pub fnc forwardable_unicast_destination(int destination): bool {
  if !valid_ipv4(destination) then
    return false;
  fi
  // 0/8, 127/8, 169.254/16 and 224/4+ are not routable unicast here.
  if destination < 16777216 ||
     (destination >= 2130706432 && destination <= 2147483647) ||
     (destination >= 2851995648 && destination <= 2852061183) ||
     destination >= 3758096384 then
    return false;
  fi
  return true;
}

pub fnc valid_prefix_length(int length): bool {
  return length >= 0 && length <= 32;
}

// 2^(32 - length) without relying on unratified Atto bitwise semantics.
pub fnc prefix_divisor(int length): int {
  if !valid_prefix_length(length) then
    return -1;
  fi
  let int divisor = 1;
  let int step = length;
  while step < 32 do
    divisor = divisor * 2;
    step = step + 1;
  done
  return divisor;
}

pub fnc ipv4_prefix_matches(int address, int network, int prefix_length): bool {
  if !valid_ipv4(address) || !valid_ipv4(network) ||
     !valid_prefix_length(prefix_length) then
    return false;
  fi
  let int address_rem = address;
  let int network_rem = network;
  let int index = 0;
  while index < prefix_length do
    let int place = 1;
    let int bit = 0;
    while bit < 31 - index do
      place = place * 2;
      bit = bit + 1;
    done
    let bool a_bit = address_rem >= place;
    let bool n_bit = network_rem >= place;
    if a_bit != n_bit then
      return false;
    fi
    if a_bit then
      address_rem = address_rem - place;
    fi
    if n_bit then
      network_rem = network_rem - place;
    fi
    index = index + 1;
  done
  return true;
}

// Header length must be a legal 4-byte-aligned IPv4 header (20..60).
// The caller MUST separately authenticate version, checksum, options,
// fragmentation, declared total length and actual byte-buffer bounds.
pub fnc valid_ipv4_packet(int total_bytes, int header_bytes, int ttl): bool {
  if !(header_bytes == 20 || header_bytes == 24 ||
       header_bytes == 28 || header_bytes == 32 ||
       header_bytes == 36 || header_bytes == 40 ||
       header_bytes == 44 || header_bytes == 48 ||
       header_bytes == 52 || header_bytes == 56 ||
       header_bytes == 60) then
    return false;
  fi
  if total_bytes < header_bytes || total_bytes > 65535 then
    return false;
  fi
  return ttl >= 1 && ttl <= 255;
}

pub fnc forwarded_ttl(int ttl): int {
  if ttl <= 1 || ttl > 255 then
    return -1;
  fi
  return ttl - 1;
}

// Two-route longest-prefix unicast decision. This is NOT an FIB or ACL.
// Returns port 0..4095 or -1 for no route/invalid destination.
// Invalid route candidates are ignored; exact ties prefer route A.
pub fnc select_egress_port(
  int destination,
  int network_a, int prefix_a, int port_a,
  int network_b, int prefix_b, int port_b
): int {
  if !forwardable_unicast_destination(destination) then
    return -1;
  fi
  let int best_port = -1;
  let int best_prefix = -1;
  if port_a >= 0 && port_a < 4096 &&
     ipv4_prefix_matches(destination, network_a, prefix_a) then
    best_port = port_a;
    best_prefix = prefix_a;
  fi
  if port_b >= 0 && port_b < 4096 && prefix_b > best_prefix &&
     ipv4_prefix_matches(destination, network_b, prefix_b) then
    best_port = port_b;
  fi
  return best_port;
}

// Never use the old destination-free admission shape: an authorized-looking
// egress port alone is not evidence that an IPv4 destination may be routed.
// Egress must come from an authenticated, generation-valid FIB lookup.
pub fnc may_forward(
  int destination, int total_bytes, int header_bytes,
  int ttl, int egress_port
): bool {
  return forwardable_unicast_destination(destination) &&
         valid_ipv4_packet(total_bytes, header_bytes, ttl) &&
         forwarded_ttl(ttl) >= 0 && egress_port >= 0 && egress_port < 4096;
}

// Exact nonnegative quotient while int / int result semantics remain undecided.
// Greedy doubling stays within signed 64-bit bounds; invalid input returns -1.
// This reference path is not constant-time or suitable for a hot data plane.
pub fnc quotient_nonnegative(int dividend, int divisor): int {
  if dividend < 0 || divisor <= 0 then
    return -1;
  fi
  let int remaining = dividend;
  let int quotient = 0;
  while remaining >= divisor do
    let int chunk = divisor;
    let int multiple = 1;
    while chunk <= remaining - chunk do
      chunk = chunk * 2;
      multiple = multiple * 2;
    done
    remaining = remaining - chunk;
    quotient = quotient + multiple;
  done
  return quotient;
}

// Reject noncanonical route advertisements before admitting forwarding.
// /0 is canonical only for network address 0.
pub fnc canonical_ipv4_network(int network, int prefix_length): bool {
  if !valid_ipv4(network) then
    return false;
  fi
  let int divisor = prefix_divisor(prefix_length);
  if divisor < 1 then
    return false;
  fi
  return network == (quotient_nonnegative(network, divisor)) * divisor;
}

// Legacy route selection permits host bits in network addresses; this
// additional entry point rejects that ambiguity before selecting routes.
pub fnc select_canonical_egress_port(
  int destination,
  int network_a, int prefix_a, int port_a,
  int network_b, int prefix_b, int port_b
): int {
  let int safe_port_a = -1;
  let int safe_port_b = -1;
  if canonical_ipv4_network(network_a, prefix_a) then
    safe_port_a = port_a;
  fi
  if canonical_ipv4_network(network_b, prefix_b) then
    safe_port_b = port_b;
  fi
  return select_egress_port(destination, network_a, prefix_a, safe_port_a,
                            network_b, prefix_b, safe_port_b);
}

pub fnc unicast_ipv4_destination(int destination): bool {
  return forwardable_unicast_destination(destination);
}

// MTU budget applies to the full IPv4 packet including its header.
// No fragmentation, subnet-broadcast resolution or checksum update occurs.
pub fnc may_forward_on_link(
  int destination, int total_bytes, int header_bytes,
  int ttl, int egress_port, int egress_mtu, bool link_up
): bool {
  if !link_up || !unicast_ipv4_destination(destination) then
    return false;
  fi
  if egress_mtu < 576 || egress_mtu > 9216 then
    return false;
  fi
  return total_bytes <= egress_mtu &&
         may_forward(destination, total_bytes, header_bytes, ttl, egress_port);
}
