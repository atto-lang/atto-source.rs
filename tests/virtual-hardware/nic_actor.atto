// Bounded AttoLang virtual NIC actor (scalar mailbox profile).
// Int mail: 60..1514 = untagged frame byte length (no FCS).
// Completion is generation * 65536 + descriptor_sequence (1..65535).
// The next expected FIFO sequence advances on each settlement; replays fail.
// -2 = link down and revoke all outstanding slots; -3 = link up;
// -4 = diagnostic counters, -5 = generation, -6 = next sequence.
// No sequence wrapping within an epoch: exhaust 65535 and reset the link.
// The transport MUST authenticate control messages and completion ownership.
// A positive admission reserves one of four actor-owned slots.
// This is NOT a driver, buffer parser, DMA queue or host authentication.
define actor VirtualNic as
    let int used = 0;
    let int drops = 0;
    let int link_up = 1;
    let int generation = 1;
    let int next_sequence = 1;
    let int oldest_sequence = 1;

    receive(ActorMail<int> mail): void {
        if mail.value == self.generation * 65536 + self.oldest_sequence then
            if self.used > 0 then
                self.used = self.used - 1;
                self.oldest_sequence = self.oldest_sequence + 1;
                stdio.println(self.used);
            else
                self.drops = self.drops + 1;
                stdio.println(-1);
            fi
        elif mail.value >= 0 then
            if self.link_up == 1 &&
               mail.value >= 60 && mail.value <= 1514 &&
               self.used < 4 && self.next_sequence < 65536 then
                self.used = self.used + 1;
                self.next_sequence = self.next_sequence + 1;
                stdio.println(self.used);
            else
                self.drops = self.drops + 1;
                stdio.println(-1);
            fi
        elif mail.value == -2 then
            self.link_up = 0;
            self.used = 0;
            self.next_sequence = 1;
            self.oldest_sequence = 1;
            if self.generation < 2147483647 then
                self.generation = self.generation + 1;
            fi
            stdio.println(-2);
        elif mail.value == -3 then
            if self.generation < 2147483647 then
                self.link_up = 1;
                stdio.println(-3);
            else
                self.drops = self.drops + 1;
                stdio.println(-1);
            fi
        elif mail.value == -4 then
            stdio.println(self.used);
            stdio.println(self.drops);
        elif mail.value == -5 then
            stdio.println(self.generation);
        elif mail.value == -6 then
            stdio.println(self.next_sequence);
        else
            self.drops = self.drops + 1;
            stdio.println(-1);
        fi
        return;
    }
end
