// Boolean composition uses the compiler-supported, short-circuit && / || operators.
// Pure AttoLang virtual Ethernet switch decisions (not a live bridge).
// Egress code: -1 DROP/TRAP; -2 controlled FLOOD; 0..4095 known port.
// Unknown unicast/broadcast/multicast flooding is never automatic:
// an owner must call flood_to_port for each authenticated VLAN member.

pub fnc valid_mac(int mac): bool {
  return mac >= 0 && mac <= 281474976710655;
}

pub fnc mac_is_group(int mac): bool {
  if !valid_mac(mac) then
    return false;
  fi
  // Isolate MAC bit 40 using bounded subtraction (no unresolved int division).
  let int remaining = mac;
  if remaining >= 140737488355328 then
    remaining = remaining - 140737488355328;
  fi
  if remaining >= 70368744177664 then
    remaining = remaining - 70368744177664;
  fi
  if remaining >= 35184372088832 then
    remaining = remaining - 35184372088832;
  fi
  if remaining >= 17592186044416 then
    remaining = remaining - 17592186044416;
  fi
  if remaining >= 8796093022208 then
    remaining = remaining - 8796093022208;
  fi
  if remaining >= 4398046511104 then
    remaining = remaining - 4398046511104;
  fi
  if remaining >= 2199023255552 then
    remaining = remaining - 2199023255552;
  fi
  return remaining >= 1099511627776;
}

// IEEE 802.1D bridge-local control addresses 01:80:C2:00:00:00..0F.
// They must NOT be unknown-multicast-flooded across a transparent bridge.
// -1 means trap to an authenticated local control plane or discard.
pub fnc reserved_bridge_control_destination(int mac): bool {
  return valid_mac(mac) && mac >= 1652522221568 && mac <= 1652522221583;
}

pub fnc valid_vlan(int vlan): bool {
  return vlan >= 1 && vlan <= 4094;
}

pub fnc valid_port(int port, int port_count): bool {
  return port_count >= 2 && port_count <= 4096 &&
         port >= 0 && port < port_count;
}

pub fnc can_learn_source(int source_mac, int ingress, int port_count, int vlan): bool {
  return valid_mac(source_mac) && source_mac != 0 &&
         !mac_is_group(source_mac) && valid_port(ingress, port_count) &&
         valid_vlan(vlan);
}

// One trusted, already-learned entry: not a substitute for actor-owned FDB.
// Destination 00:00:00:00:00:00 and bridge-local control frames DROP.
// Mismatched/stale entry FLOODs by policy; structurally corrupt entry DROPs.
// Callers MUST validate ingress port VLAN membership before this function.
pub fnc select_egress_port(
  int destination_mac, int ingress, int port_count, int frame_vlan,
  int learned_mac, int learned_port, int learned_vlan,
  int age_seconds, int max_age_seconds
): int {
  if !valid_mac(destination_mac) || destination_mac == 0 ||
     reserved_bridge_control_destination(destination_mac) ||
     !valid_port(ingress, port_count) || !valid_vlan(frame_vlan) then
    return -1;
  fi
  if mac_is_group(destination_mac) then
    return -2;
  fi
  if destination_mac != learned_mac || frame_vlan != learned_vlan then
    return -2;
  fi
  if !valid_port(learned_port, port_count) ||
     age_seconds < 0 || max_age_seconds < 1 || max_age_seconds > 86400 then
    return -1;
  fi
  if age_seconds > max_age_seconds then
    return -2;
  fi
  if learned_port == ingress then
    return -1;
  fi
  return learned_port;
}

// All flood recipients MUST be validated with the destination address,
// ingress/candidate separation, candidate link state and VLAN membership.
// 'candidate_vlan' is a trusted port configuration, not a packet claim.
pub fnc flood_to_port(
  int destination_mac, int ingress, int candidate, int port_count,
  int frame_vlan, int candidate_vlan, bool candidate_up
): bool {
  if !valid_mac(destination_mac) || destination_mac == 0 ||
     reserved_bridge_control_destination(destination_mac) then
    return false;
  fi
  return valid_port(ingress, port_count) &&
         valid_port(candidate, port_count) &&
         candidate != ingress && candidate_up &&
         valid_vlan(frame_vlan) && frame_vlan == candidate_vlan;
}

// Frame lengths exclude the four-byte Ethernet FCS. 802.1Q adds four bytes.
// A virtual switch's access port maps untagged frames to a valid PVID.
pub fnc valid_ethernet_frame(int bytes, int mtu, bool tagged): bool {
  if mtu < 576 || mtu > 9216 then
    return false;
  fi
  if tagged then
    return bytes >= 64 && bytes <= mtu + 18;
  fi
  return bytes >= 60 && bytes <= mtu + 14;
}

pub fnc can_admit_ingress_frame(
  int bytes, int mtu, int ingress, int port_count,
  int assigned_vlan, bool tagged, bool ingress_up
): bool {
  return ingress_up && valid_port(ingress, port_count)
    && valid_vlan(assigned_vlan) && valid_ethernet_frame(bytes, mtu, tagged);
}

// 00:00:00:00:00:00 is not a valid unicast destination for forwarding.
pub fnc valid_unicast_destination_mac(int mac): bool {
  return valid_mac(mac) && mac != 0 && !mac_is_group(mac);
}

// Egress codes remain -1 drop, -2 flood, >=0 a specific port.
// Mainline egress policy also rejects bridge-local control frames and bad ingress.
pub fnc select_safe_egress_port(
  int destination_mac, int ingress, int port_count, int frame_vlan,
  int learned_mac, int learned_port, int learned_vlan,
  int age_seconds, int max_age_seconds
): int {
  if !valid_mac(destination_mac) || destination_mac == 0 then
    return -1;
  fi
  return select_egress_port(destination_mac, ingress, port_count, frame_vlan,
                             learned_mac, learned_port, learned_vlan,
                             age_seconds, max_age_seconds);
}
