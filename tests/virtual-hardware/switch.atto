// Pure AttoLang virtual Ethernet switch forwarding core.
// Egress codes: -1 drop, -2 flood to all eligible ports EXCEPT ingress,
// >=0 one port. The caller must enforce port/VLAN membership on flood.

// Exact nonnegative integer quotient, independent of undecided int / int semantics.
// Greedy doubling is bounded by signed int width; invalid operands return -1.
// This is not a constant-time or hot-path optimized primitive.
pub fnc quotient_nonnegative(int dividend, int divisor): int {
  if dividend < 0 || divisor <= 0 then
    return -1;
  fi
  let int remaining = dividend;
  let int quotient = 0;
  while remaining >= divisor do
    let int chunk = divisor;
    let int multiple = 1;
    while chunk <= remaining - chunk do
      chunk = chunk * 2;
      multiple = multiple * 2;
    done
    remaining = remaining - chunk;
    quotient = quotient + multiple;
  done
  return quotient;
}

pub fnc valid_mac(int mac): bool {
  return mac >= 0 && mac <= 281474976710655;
}

pub fnc mac_is_group(int mac): bool {
  if !valid_mac(mac) then
    return false;
  fi
  let int first_octet = quotient_nonnegative(mac, 1099511627776);
  return first_octet != (quotient_nonnegative(first_octet, 2)) * 2;
}

pub fnc valid_vlan(int vlan): bool {
  return vlan >= 1 && vlan <= 4094;
}

pub fnc valid_port(int port, int port_count): bool {
  return port_count >= 2 && port_count <= 4096 &&
         port >= 0 && port < port_count;
}

pub fnc can_learn_source(int source_mac, int ingress, int port_count, int vlan): bool {
  return valid_mac(source_mac) && source_mac != 0 &&
         !mac_is_group(source_mac) && valid_port(ingress, port_count) &&
         valid_vlan(vlan);
}

// One already-learned entry. An actor-owned FDB will call this only after
// authenticating the entry's generation and the ingress VLAN.
// Do NOT treat a caller-provided learned entry as an authenticated FDB.
pub fnc select_egress_port(
  int destination_mac, int ingress, int port_count, int frame_vlan,
  int learned_mac, int learned_port, int learned_vlan,
  int age_seconds, int max_age_seconds
): int {
  if !valid_mac(destination_mac) || !valid_port(ingress, port_count) ||
     !valid_vlan(frame_vlan) then
    return -1;
  fi
  if mac_is_group(destination_mac) then
    return -2;
  fi
  if destination_mac != learned_mac || frame_vlan != learned_vlan then
    return -2;
  fi
  if !valid_port(learned_port, port_count) ||
     age_seconds < 0 || max_age_seconds < 1 ||
     max_age_seconds > 86400 || age_seconds > max_age_seconds then
    return -2;
  fi
  if learned_port == ingress then
    return -1;
  fi
  return learned_port;
}

pub fnc flood_to_port(
  int ingress, int candidate, int port_count,
  int frame_vlan, int candidate_vlan, bool candidate_up
): bool {
  return valid_port(ingress, port_count) &&
         valid_port(candidate, port_count) &&
         candidate != ingress && candidate_up &&
         valid_vlan(frame_vlan) && frame_vlan == candidate_vlan;
}

// Frame lengths exclude the four-byte Ethernet FCS. 802.1Q adds four bytes.
// A virtual switch's access port maps untagged frames to a valid PVID.
pub fnc valid_ethernet_frame(int bytes, int mtu, bool tagged): bool {
  if mtu < 576 || mtu > 9216 then
    return false;
  fi
  if tagged then
    return bytes >= 64 && bytes <= mtu + 18;
  fi
  return bytes >= 60 && bytes <= mtu + 14;
}

pub fnc can_admit_ingress_frame(
  int bytes, int mtu, int ingress, int port_count,
  int assigned_vlan, bool tagged, bool ingress_up
): bool {
  return ingress_up && valid_port(ingress, port_count)
    && valid_vlan(assigned_vlan) && valid_ethernet_frame(bytes, mtu, tagged);
}

// 00:00:00:00:00:00 is not a valid unicast destination for forwarding.
pub fnc valid_unicast_destination_mac(int mac): bool {
  return valid_mac(mac) && mac != 0 && !mac_is_group(mac);
}

// Egress codes remain -1 drop, -2 flood, >=0 a specific port.
// This wrapper prevents accidental delivery to the all-zero destination.
pub fnc select_safe_egress_port(
  int destination_mac, int ingress, int port_count, int frame_vlan,
  int learned_mac, int learned_port, int learned_vlan,
  int age_seconds, int max_age_seconds
): int {
  if !valid_mac(destination_mac) || destination_mac == 0 then
    return -1;
  fi
  if mac_is_group(destination_mac) then
    return -2;
  fi
  return select_egress_port(destination_mac, ingress, port_count, frame_vlan,
                             learned_mac, learned_port, learned_vlan,
                             age_seconds, max_age_seconds);
}
