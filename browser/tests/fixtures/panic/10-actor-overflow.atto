// Integer overflow inside an actor panics that actor (checked int, spec 17).
// expect-panic: 1
// expect-stdout: 7
define actor W as
    receive(ActorMail<int> mail): void {
        stdio.println(mail.value);
        stdio.println(mail.value * 9223372036854775807);
        return;
    }
end

pub fnc main(): int {
    val a = spawn W();
    a.send(7);
    return 0;
}
