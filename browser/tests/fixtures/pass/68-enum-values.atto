// define enum follows the oreslang-source.llvm v1 design contract
// (contracts/v1/design/enum_pattern_cases.json); Java does not parse it yet.
// java: llvm-design
// expect-exit: 42
define enum Status as
    Pending
    Running
    Done
end

define class Job as
    mut Status state = Status.Pending;
    constructor(Status s) { self.state = s; }
    pub status(): Status { return self.state; }
end

fnc advance(Status s): Status {
    if s eq Status.Pending then
        return Status.Running;
    fi
    return Status.Done;
}

pub fnc main(): int {
    val j = new Job(Status.Pending);
    val next = advance(j.status());
    if next eq Status.Running, advance(next) eq Status.Done, next neq Status.Done then
        return 42;
    fi
    return 0;
}
