// Privacy is per class: a method may read another instance's private field.
// expect-exit: 42
define class P as
    mut int x = 0;
    pub bool ok: true
    constructor(int v) { self.x = v; }
    pub plus(P other): int { return self.x + other.x; }
end

pub fnc main(): int {
    val a = new P(40);
    val b = new P(2);
    if a.ok then
        return a.plus(b);
    fi
    return 0;
}
