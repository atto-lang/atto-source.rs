// ActorRef is a copyable capability: passing or rebinding it does not move it.
// expect-exit: 0
// expect-stdout: 9
// expect-stdout: 10
// expect-stdout: 11
define actor W as
    receive(ActorMail<int> mail): void {
        stdio.println(mail.value);
        return;
    }
end

fnc go(ActorRef<W> w): void {
    w.send(9);
    return;
}

pub fnc main(): int {
    val a = spawn W();
    go(a);
    a.send(10);
    val b = a;
    b.send(11);
    return 0;
}
